# Copy to deploy/ansible/.env, fill in real values, then load it into your
# shell before running ansible-playbook (these become Ansible vars via
# lookup('env', ...) in playbook.yml):
#
#   set -a && source deploy/ansible/.env && set +a
#   ansible-playbook -i deploy/ansible/inventory.ini deploy/ansible/playbook.yml
#
# db_password and jwt_secret are required — the playbook refuses to run
# without them rather than silently deploying with a placeholder secret.
#
# Production vs. development (Swagger at /docs) is controlled separately by
# the `env` extra-var on the ansible-playbook command, not by this file —
# see the README's Raspberry Pi Deployment section.

# Domain & SSL — Caddy requests a Let's Encrypt cert for DOMAIN_NAME using
# ACME_EMAIL. Use "localhost" for LAN-only access with no TLS.
DOMAIN_NAME=mindful.local
ACME_EMAIL=admin@example.com

# PostgreSQL credentials created on the Raspberry Pi (postgres role)
DB_USER=mindful_user
DB_PASSWORD=
DB_NAME=mindful_plate

# JWT signing secret — required, 32+ characters
JWT_SECRET=

# Google Gemini API key for AI meal/recipe analysis (optional — AI features
# are disabled server-side without it, everything else still works)
GEMINI_API_KEY=
