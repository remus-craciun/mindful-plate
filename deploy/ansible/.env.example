# Copy to deploy/ansible/.env, fill in real values, then load it into your
# shell before running ansible-playbook (these become Ansible vars via
# lookup('env', ...) in playbook.yml and inventory.yml):
#
#   set -a && source deploy/ansible/.env && set +a
#   ansible-playbook -i deploy/ansible/inventory.yml deploy/ansible/playbook.yml
#
# HOST is required. DATABASE_URL and JWT_SECRET are required too — the
# playbook refuses to run without them rather than silently deploying with a
# placeholder secret.
#
# This playbook only pulls the code and builds/runs a Docker container — it
# does not install or configure anything else. Docker and Postgres must
# already be set up on the host.

# SSH connection to the deployment host (used by deploy/ansible/inventory.yml
# and deploy/scripts/deploy.ts)
HOST=
SSH_USER=deploy
# Leave blank to use your default SSH key / ssh-agent instead of a specific file.
SSH_KEY=~/.ssh/id_rsa

# Git remote pulled on the host (defaults to this repo's own origin)
GIT_REPO_URL=https://github.com/remus-craciun/mindful-plate.git
GIT_BRANCH=main

# PostgreSQL connection string the container will use — must already exist
# on the host; this playbook does not install or configure Postgres. Use
# host.docker.internal (not localhost) as the DB host — the container is run
# with --add-host=host.docker.internal:host-gateway so that reaches Postgres
# running natively on the host.
DATABASE_URL=postgresql://mindful_user:changeme@host.docker.internal:5432/mindful_plate

# JWT signing secret — required, 32+ characters
JWT_SECRET=

# Google Gemini API key for AI meal/recipe analysis (optional — AI features
# are disabled server-side without it, everything else still works)
GEMINI_API_KEY=
