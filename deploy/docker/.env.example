# Environment: 'production' (disables Swagger) or 'development' (enables Swagger at /docs)
NODE_ENV=production

# Domain & SSL
DOMAIN_NAME=mindful.local
ACME_EMAIL=admin@example.com

# Database Connection (Connects to host's native PostgreSQL)
DB_USER=mindful_user
DB_PASSWORD=mindful_secure_password_here
DB_NAME=mindful_plate

# App Secret
JWT_SECRET=super_secret_production_jwt_key_at_least_32_chars_long!

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
