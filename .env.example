# ==========================================
# Mindful Plate Monorepo Root Environment
# ==========================================

# Server Settings
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindful_plate

# Security
JWT_SECRET=mindful_plate_super_secure_jwt_secret_key_123!

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Mobile API Endpoint (for React Native Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000
