# Server Configuration
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindful_plate

# Secret key used for signing JWT tokens (min 16 chars)
JWT_SECRET=mindful_plate_super_secure_jwt_secret_key_123!

# Google Gemini API Key for Multimodal Food & Plate Analysis
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
